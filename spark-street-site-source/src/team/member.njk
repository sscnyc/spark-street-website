---
pagination:
  data: coreTeam
  size: 1
  alias: person
permalink: "/team/{{ person.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ person.name }}"
  description: "{{ person.title }} at Spark Street Advisors, {{ person.location }}."
---
<section class="bio-page">
  <div class="wrap">
    <a class="back-link" href="/team/core-team/">← Back to Core Team</a>
    <div class="person-header">
      <h1>{{ person.name }}</h1>
      <div class="role">{{ person.title }}</div>
      <div class="loc">{{ person.location }}</div>
      {% if person.status %}<div class="status">{{ person.status }}</div>{% endif %}
      <div class="contact-links">
        <a href="{{ person.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:{{ person.email }}?subject=Spark Street Advisors">Email</a>
      </div>
    </div>
    <p style="max-width:680px;">{{ person.bio }}</p>
  </div>
</section>
